# npm run dev reads this file when copied to .env. Existing shell variables win.
SCC_DEV_HOST=127.0.0.1
SCC_DEV_PORT=4173

# Set to 1 to open the trusted renderer DevTools in a separate window.
SCC_OPEN_DEVTOOLS=0

# Optional timeout for npm run test:sites (milliseconds per site).
SCC_SITE_SMOKE_TIMEOUT=30000

# Test-only browser-source hooks. Leave disabled for normal development.
SCC_BROWSER_SOURCE_AUTOSTART=0
SCC_BROWSER_SOURCE_URL=https://example.com/
