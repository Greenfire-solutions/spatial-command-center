{
  "name": "spatial-command-center",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A React Three Fiber spatial workspace with Electron offscreen Chromium sources.",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "dev:browser": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node scripts/ensure-build.mjs && node scripts/run-electron.mjs .",
    "start:built": "npm run build && npm start",
    "test": "npm run test:unit",
    "test:unit": "node --test \"electron/test/**/*.test.cjs\" \"src/**/*.test.mjs\"",
    "test:runtime": "node scripts/run-electron.mjs electron/integration/offscreen-smoke.cjs",
    "test:poc": "npm run build && node scripts/electron-poc-smoke.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:xr": "node scripts/xr-harness-smoke.mjs",
    "test:sites": "node scripts/run-electron.mjs electron/integration/site-smoke.cjs",
    "test:host": "node scripts/host-smoke.mjs",
    "test:all": "npm run test:unit && npm run test:runtime && npm run test:poc",
    "xr:serve": "node scripts/serve-xr.mjs",
    "xr:serve:https": "node scripts/serve-xr.mjs --https",
    "vr": "node scripts/vr.mjs",
    "host": "node scripts/run-electron.mjs electron/host/remote-host.cjs",
    "host:https": "node scripts/run-electron.mjs electron/host/remote-host.cjs -- --https"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@react-three/drei": "9.105.6",
    "@react-three/fiber": "8.16.2",
    "@react-three/xr": "^6.6.30",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "three": "0.163.0",
    "ws": "^8.21.3",
    "zustand": "4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "electron": "^43.5.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.3"
  }
}
